<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Andengradspolynomier | Sankt Annæ 2.a</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-glow: rgba(79, 70, 229, 0.15);
            --slate-bg: #f8fafc;
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--slate-bg);
            color: #0f172a;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Math Particle Canvas */
        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            pointer-events: none;
            opacity: 0.5;
        }

        /* Dynamiske Baggrunds-blobs */
        .bg-blob {
            position: fixed;
            z-index: -1;
            filter: blur(120px);
            opacity: 0.15;
            pointer-events: none;
            border-radius: 50%;
            animation: drift 25s infinite alternate ease-in-out;
        }

        @keyframes drift {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(60px, -60px) scale(1.1); }
        }

        .content-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid #e2e8f0;
            border-radius: 2rem;
            padding: 2.5rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        }

        .math-block {
            font-family: 'Fira Code', monospace;
            background: #0f172a;
            color: #818cf8;
            padding: 1rem 1.5rem;
            border-radius: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 1rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .rule-box {
            background: rgba(79, 70, 229, 0.05);
            border-left: 4px solid var(--primary);
            padding: 1.5rem;
            border-radius: 0 1rem 1rem 0;
            margin: 1.5rem 0;
        }

        .btn-copy {
            background: rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-size: 0.8rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all 0.2s;
        }

        .btn-copy:hover {
            background: var(--primary);
            color: white;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--slate-bg); }
        ::-webkit-scrollbar-thumb { background: rgba(79, 70, 229, 0.3); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(79, 70, 229, 0.6); }
    </style>
</head>
<body class="min-h-screen pb-20">

    <!-- Animeret Partikel System -->
    <canvas id="particle-canvas"></canvas>

    <!-- Background Blobs -->
    <div class="bg-blob w-[600px] h-[600px] bg-indigo-300 top-[-10%] left-[10%]"></div>
    <div class="bg-blob w-[500px] h-[500px] bg-purple-200 bottom-[10%] right-[-10%]"></div>

    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-indigo-100 shadow-sm">
        <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="matematik-skriftlig.html" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 rounded-full flex items-center justify-center transition-colors text-slate-600">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <span class="text-xl font-black tracking-tight block leading-none text-slate-900 uppercase">Andengrads<span class="text-indigo-500">polynomier</span></span>
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-1">Sankt Annæ Gymnasium 2.a</span>
                </div>
            </div>
            <div class="flex items-center gap-4 hidden sm:flex">
                <a href="opgavebank.html" class="text-xs font-black text-slate-500 hover:text-indigo-600 transition uppercase tracking-widest flex items-center gap-2">
                    <i class="fas fa-dumbbell"></i> Træn Emnet
                </a>
                <a href="maple.html" class="px-5 py-2 bg-indigo-50 text-indigo-600 rounded-full text-xs font-bold hover:bg-indigo-600 hover:text-white transition-all active:scale-95 uppercase tracking-wider border border-indigo-200">
                    Maple Guide
                </a>
            </div>
        </div>
    </nav>

    <!-- Header Section -->
    <header class="max-w-4xl mx-auto px-6 pt-16 pb-12 text-center relative">
        <div class="inline-block mb-4 px-4 py-1.5 rounded-full bg-purple-50 border border-purple-100 text-purple-600 font-bold text-xs tracking-widest uppercase shadow-sm">
            Emne 03
        </div>
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter text-slate-900 mb-6 uppercase">
            Parablen & <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-500 to-indigo-500 italic">Rødderne</span>
        </h1>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto font-medium">
            Lær at mestre den bløde bue. Her gennemgår vi forskriften, hvad a, b og c betyder for grafens udseende, samt hvordan du finder toppunktet og rødderne.
        </p>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6">
        
        <!-- Sektion 1: Forskriften og Konstanterne -->
        <section class="content-card border-t-4 border-t-purple-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center">
                    <i class="fas fa-draw-polygon text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">1. Forskriften og a, b, c</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Et andengradspolynomium har altid et led, hvor x er opløftet i anden potens (x²). Grafen kaldes en <strong>parabel</strong>.
            </p>

            <div class="math-block block space-y-1 !bg-purple-900/10 !border-purple-500/30">
                <div class="text-center text-2xl font-bold text-purple-600">f(x) = a·x² + b·x + c</div>
                <div class="text-center text-sm text-purple-400 mt-2">Betingelse: a må ikke være 0.</div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-purple-600 mb-2">Tallet a</h4>
                    <p class="text-sm text-slate-600">Bestemmer om grenene vender op eller ned.<br>
                    <strong>a > 0:</strong> "Glad" parabel (grenene op).<br>
                    <strong>a < 0:</strong> "Sur" parabel (grenene ned).</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-purple-600 mb-2">Tallet b</h4>
                    <p class="text-sm text-slate-600">Bestemmer parablens hældning lige præcis der, hvor den skærer y-aksen.<br>
                    <strong>b > 0:</strong> Går opad ved skæring.<br>
                    <strong>b < 0:</strong> Går nedad ved skæring.</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-purple-600 mb-2">Tallet c</h4>
                    <p class="text-sm text-slate-600">Ligesom i linjens ligning, bestemmer c præcis hvor grafen skærer y-aksen.<br>
                    Skæringspunkt = <strong>(0, c)</strong></p>
                </div>
            </div>
        </section>

        <!-- Sektion 2: Diskriminanten -->
        <section class="content-card border-t-4 border-t-indigo-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center">
                    <span class="font-serif italic font-bold text-xl">d</span>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">2. Diskriminanten (d)</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Diskriminanten er et vigtigt hjælpetal. Den beregnes ud fra a, b og c og fortæller os, hvor mange gange grafen skærer x-aksen (hvor mange "rødder" der er).
            </p>

            <div class="math-block block space-y-1 !bg-indigo-900/10 !border-indigo-500/30">
                <div class="text-center text-2xl font-bold text-indigo-600">d = b² - 4·a·c</div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
                <div class="text-center p-4 border border-emerald-100 bg-emerald-50 rounded-2xl">
                    <div class="font-black text-emerald-600 text-lg mb-1">d > 0</div>
                    <p class="text-sm text-slate-600">Grafen skærer x-aksen to gange. Der er <strong>2 rødder</strong>.</p>
                </div>
                <div class="text-center p-4 border border-amber-100 bg-amber-50 rounded-2xl">
                    <div class="font-black text-amber-600 text-lg mb-1">d = 0</div>
                    <p class="text-sm text-slate-600">Grafen rører x-aksen i ét punkt (toppunktet). Der er <strong>1 rod</strong>.</p>
                </div>
                <div class="text-center p-4 border border-rose-100 bg-rose-50 rounded-2xl">
                    <div class="font-black text-rose-600 text-lg mb-1">d < 0</div>
                    <p class="text-sm text-slate-600">Grafen svæver over eller under x-aksen. Der er <strong>0 rødder</strong>.</p>
                </div>
            </div>
        </section>

        <!-- Sektion 3: Rødderne (Nulpunkter) -->
        <section class="content-card border-t-4 border-t-blue-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
                    <i class="fas fa-grip-lines text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">3. Rødder (Løsninger)</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Når man løser andengradsligningen <code class="bg-slate-100 px-1 rounded text-slate-700">ax² + bx + c = 0</code>, finder man rødderne. Formlen for at udregne selve x-værdierne afhænger af diskriminanten.
            </p>

            <div class="rule-box !border-blue-500 !bg-blue-50/50">
                <h3 class="font-bold text-blue-900 mb-4">Rod-formlen (hvis d ≥ 0)</h3>
                <div class="math-block !m-0 justify-center text-blue-600 text-xl font-bold">
                    x = (-b ± √d) / (2·a)
                </div>
                <p class="text-sm text-slate-600 mt-4 text-center">
                    Det betyder at den ene x-værdi findes ved at sige <strong>plus √d</strong>, og den anden findes ved at sige <strong>minus √d</strong>.
                </p>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-slate-800">Den hurtige i Maple</h4>
                    <p class="text-sm text-slate-500">Du behøver ikke formlen i Maple, brug bare solve!</p>
                </div>
                <button onclick="copyToClipboard('solve(a*x^2 + b*x + c = 0, x)')" class="btn-copy !bg-slate-100 !text-slate-600 hover:!bg-blue-600 hover:!text-white border border-slate-200">
                    <i class="far fa-copy mr-2"></i>Kopiér
                </button>
            </div>
        </section>

        <!-- Sektion 4: Toppunktet -->
        <section class="content-card border-t-4 border-t-cyan-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-cyan-100 text-cyan-600 flex items-center justify-center">
                    <i class="fas fa-mountain text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">4. Toppunktet</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Parablens vendepunkt kaldes toppunktet, uanset om det er det højeste punkt (for en sur parabel) eller det laveste punkt (for en glad parabel). Koordinatsættet (x, y) har sin egen formel.
            </p>

            <div class="math-block block space-y-1 !bg-cyan-900/10 !border-cyan-500/30">
                <div class="text-center text-xl font-bold text-cyan-600">T = ( -b / 2a , -d / 4a )</div>
            </div>

            <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100 mt-6">
                <h4 class="font-bold text-slate-800 mb-2">Alternativ metode (Differentialregning)</h4>
                <p class="text-sm text-slate-600">
                    I stedet for at huske formlen for toppunktet, kan du altid finde toppunktets x-værdi ved at sætte den afledte funktion lig nul. Fordi hældningen i toppunktet altid er 0.
                </p>
                <div class="mt-3 flex gap-2">
                    <button onclick="copyToClipboard('solve(f\\'(x) = 0, x)')" class="btn-copy !bg-slate-200 !text-slate-700 hover:!bg-cyan-500 hover:!text-white">
                        <i class="far fa-copy mr-2"></i>solve(f'(x) = 0, x)
                    </button>
                </div>
            </div>
        </section>

        <!-- Navigation (Forrige / Næste) -->
        <div class="flex flex-col sm:flex-row justify-between gap-4 mb-12">
            <a href="mat-funktioner.html" class="px-6 py-4 bg-white border border-slate-200 text-slate-600 rounded-2xl font-bold hover:bg-slate-50 transition-colors flex items-center justify-center gap-3">
                <i class="fas fa-arrow-left"></i>
                Forrige: Funktioner & Regres.
            </a>
            <a href="#" class="px-6 py-4 bg-slate-900 text-white rounded-2xl font-bold hover:bg-indigo-600 transition-colors shadow-lg shadow-indigo-500/20 flex items-center justify-center gap-3">
                Næste: Differentialregning
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    </main>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-3 rounded-xl shadow-2xl opacity-0 transition-all pointer-events-none z-[100] flex items-center space-x-3 border border-slate-700">
        <i class="fas fa-check text-emerald-400"></i>
        <span class="font-bold text-sm">Kopieret til udklipsholder!</span>
    </div>

    <script>
        // Kopiér funktion
        function copyToClipboard(text) {
            const el = document.createElement('textarea');
            el.value = text;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);

            const toast = document.getElementById('toast');
            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -10px)';
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, 0)';
            }, 2500);
        }

        // --- Math Particle Animation ---
        const canvas = document.getElementById('particle-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        const mathSymbols = ['x²', 'd', 'ax²+bx+c', '√d', 'a', 'b', 'c', 'T', '0'];

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        class MathParticle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.symbol = mathSymbols[Math.floor(Math.random() * mathSymbols.length)];
                this.fontSize = Math.random() * 15 + 10;
                this.speedX = (Math.random() - 0.5) * 0.3;
                this.speedY = (Math.random() - 0.5) * 0.3;
                const colors = ['rgba(79, 70, 229, 0.3)', 'rgba(168, 85, 247, 0.3)', 'rgba(59, 130, 246, 0.3)'];
                this.color = colors[Math.floor(Math.random() * colors.length)];
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x > canvas.width + 20) this.x = -20;
                if (this.x < -20) this.x = canvas.width + 20;
                if (this.y > canvas.height + 20) this.y = -20;
                if (this.y < -20) this.y = canvas.height + 20;
            }
            draw() {
                ctx.fillStyle = this.color;
                ctx.font = `${this.fontSize}px 'Fira Code', monospace`;
                ctx.fillText(this.symbol, this.x, this.y);
            }
        }

        function initParticles() {
            particles = [];
            const particleCount = Math.floor(window.innerWidth / 30); 
            for (let i = 0; i < Math.min(particleCount, 50); i++) {
                particles.push(new MathParticle());
            }
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }

        window.addEventListener('resize', () => {
            resize();
            initParticles();
        });
        
        window.onload = () => {
            resize();
            initParticles();
            animateParticles();
        };
    </script>
</body>
</html>
