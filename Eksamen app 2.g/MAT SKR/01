<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Basis & Ligninger | Sankt Annæ 2.a</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-glow: rgba(79, 70, 229, 0.15);
            --slate-bg: #f8fafc;
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--slate-bg);
            color: #0f172a;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Math Particle Canvas */
        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            pointer-events: none;
            opacity: 0.5;
        }

        /* Dynamiske Baggrunds-blobs */
        .bg-blob {
            position: fixed;
            z-index: -1;
            filter: blur(120px);
            opacity: 0.15;
            pointer-events: none;
            border-radius: 50%;
            animation: drift 25s infinite alternate ease-in-out;
        }

        @keyframes drift {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(60px, -60px) scale(1.1); }
        }

        .content-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid #e2e8f0;
            border-radius: 2rem;
            padding: 2.5rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        }

        .math-block {
            font-family: 'Fira Code', monospace;
            background: #0f172a;
            color: #818cf8;
            padding: 1rem 1.5rem;
            border-radius: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 1rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .rule-box {
            background: rgba(79, 70, 229, 0.05);
            border-left: 4px solid var(--primary);
            padding: 1.5rem;
            border-radius: 0 1rem 1rem 0;
            margin: 1.5rem 0;
        }

        .btn-copy {
            background: rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-size: 0.8rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all 0.2s;
        }

        .btn-copy:hover {
            background: var(--primary);
            color: white;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--slate-bg); }
        ::-webkit-scrollbar-thumb { background: rgba(79, 70, 229, 0.3); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(79, 70, 229, 0.6); }
    </style>
</head>
<body class="min-h-screen pb-20">

    <!-- Animeret Partikel System (Math Symbols) -->
    <canvas id="particle-canvas"></canvas>

    <!-- Background Blobs -->
    <div class="bg-blob w-[600px] h-[600px] bg-indigo-300 top-[-10%] left-[-10%]"></div>
    <div class="bg-blob w-[500px] h-[500px] bg-blue-200 bottom-[10%] right-[-10%]"></div>

    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-indigo-100 shadow-sm">
        <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="matematik-skriftlig.html" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 rounded-full flex items-center justify-center transition-colors text-slate-600">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <span class="text-xl font-black tracking-tight block leading-none text-slate-900 uppercase">Basis & <span class="text-indigo-500">Ligninger</span></span>
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-1">Sankt Annæ Gymnasium 2.a</span>
                </div>
            </div>
            <div class="flex items-center gap-4 hidden sm:flex">
                <a href="opgavebank.html" class="text-xs font-black text-slate-500 hover:text-indigo-600 transition uppercase tracking-widest flex items-center gap-2">
                    <i class="fas fa-dumbbell"></i> Træn Emnet
                </a>
                <a href="maple.html" class="px-5 py-2 bg-indigo-50 text-indigo-600 rounded-full text-xs font-bold hover:bg-indigo-600 hover:text-white transition-all active:scale-95 uppercase tracking-wider border border-indigo-200">
                    Maple Guide
                </a>
            </div>
        </div>
    </nav>

    <!-- Header Section -->
    <header class="max-w-4xl mx-auto px-6 pt-16 pb-12 text-center relative">
        <div class="inline-block mb-4 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-600 font-bold text-xs tracking-widest uppercase shadow-sm">
            Emne 01
        </div>
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter text-slate-900 mb-6 uppercase">
            Det basale <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-blue-500 italic">Værktøj</span>
        </h1>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto font-medium">
            Før vi kan kaste os over differentialregning og andengradspolynomier, skal vi have styr på fundamentet. Her finder du reglerne for brøker, reduktion og løsning af ligninger.
        </p>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6">
        
        <!-- Sektion 1: Ligningsløsning -->
        <section class="content-card border-t-4 border-t-indigo-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center">
                    <i class="fas fa-equals text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">1. Løsning af Ligninger</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                At løse en ligning handler om at finde den (eller de) x-værdier, der gør udsagnet sandt. Den gyldne regel er: <strong>Hvad du gør på den ene side af lighedstegnet, skal du også gøre på den anden side.</strong>
            </p>

            <div class="rule-box">
                <h3 class="font-bold text-indigo-900 mb-2">Trin-for-trin løsning af en lineær ligning:</h3>
                <ul class="list-none space-y-3 text-slate-700 text-sm">
                    <li><span class="font-mono bg-white px-2 py-1 rounded text-indigo-600 border border-indigo-100 shadow-sm mr-2">1</span> Gang parenteser ud og reducér på begge sider.</li>
                    <li><span class="font-mono bg-white px-2 py-1 rounded text-indigo-600 border border-indigo-100 shadow-sm mr-2">2</span> Saml alle led med <code class="text-indigo-500 font-bold">x</code> på den ene side, og alle tal på den anden.</li>
                    <li><span class="font-mono bg-white px-2 py-1 rounded text-indigo-600 border border-indigo-100 shadow-sm mr-2">3</span> Isolér <code class="text-indigo-500 font-bold">x</code> ved at dividere eller gange.</li>
                </ul>
            </div>

            <div class="mt-6">
                <h4 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-2">Eksempel</h4>
                <div class="math-block block space-y-2">
                    <div>3(x - 2) + 4 = x + 10</div>
                    <div class="text-slate-500 text-sm">Ganger parentesen ud:</div>
                    <div>3x - 6 + 4 = x + 10</div>
                    <div class="text-slate-500 text-sm">Reducerer venstre side:</div>
                    <div>3x - 2 = x + 10</div>
                    <div class="text-slate-500 text-sm">Trækker x fra på begge sider, og lægger 2 til:</div>
                    <div>2x = 12</div>
                    <div class="text-slate-500 text-sm">Deler med 2:</div>
                    <div class="text-emerald-400 font-bold text-xl mt-2">x = 6</div>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-slate-800">Løs det i Maple</h4>
                    <p class="text-sm text-slate-500">Brug <code>solve</code> for eksakte svar.</p>
                </div>
                <button onclick="copyToClipboard('solve(3*(x-2)+4 = x+10, x)')" class="btn-copy hover:bg-indigo-600 hover:text-white bg-slate-100 text-slate-600 border border-slate-200">
                    <i class="far fa-copy mr-2"></i>Kopiér
                </button>
            </div>
        </section>

        <!-- Sektion 2: Isolering af Variabler -->
        <section class="content-card border-t-4 border-t-blue-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
                    <i class="fas fa-arrows-alt-h text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">2. Isolering af Variabler</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Nogle gange har du en formel, hvor du kender resultatet, men mangler en af variablerne inde i formlen. Her skal du "ombygge" formlen ved at isolere den ønskede variabel.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-slate-800 mb-3 text-sm">Fysik-klassikeren (Hastighed)</h4>
                    <div class="math-block block !bg-white !border-slate-200 text-slate-800">
                        <div class="text-blue-600">v = d / t</div>
                        <div class="text-xs text-slate-400 my-2">Isolér d (gang med t på begge sider):</div>
                        <div class="text-blue-600 font-bold">d = v * t</div>
                        <div class="text-xs text-slate-400 my-2">Isolér t (byt rundt på v og t):</div>
                        <div class="text-blue-600 font-bold">t = d / v</div>
                    </div>
                </div>

                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-slate-800 mb-3 text-sm">Matematik-klassikeren (Linjens ligning)</h4>
                    <div class="math-block block !bg-white !border-slate-200 text-slate-800">
                        <div class="text-blue-600">y = a*x + b</div>
                        <div class="text-xs text-slate-400 my-2">Isolér x (træk b fra, del med a):</div>
                        <div class="text-blue-600">y - b = a*x</div>
                        <div class="text-blue-600 font-bold mt-2">x = (y - b) / a</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sektion 3: Brøkregneregler -->
        <section class="content-card border-t-4 border-t-cyan-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-cyan-100 text-cyan-600 flex items-center justify-center">
                    <span class="font-serif italic font-bold text-xl">½</span>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">3. Brøkregneregler</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-6">
                Brøker driller tit, men det er ofte bare et spørgsmål om at huske de tre primære regler. En brøk består altid af en <strong>Tæller</strong> (i Toppen) og en <strong>Nævner</strong> (Nedenunder).
            </p>

            <div class="space-y-4">
                <!-- Addition -->
                <div class="p-5 border border-slate-100 rounded-2xl flex flex-col md:flex-row gap-6 items-center hover:shadow-md transition-shadow">
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-800 mb-2">Plus & Minus (Addition/Subtraktion)</h4>
                        <p class="text-sm text-slate-500">For at lægge to brøker sammen, <strong>SKAL</strong> de have samme nævner (fællesnævner). Man forlænger brøkerne ved at gange op og nede med samme tal.</p>
                    </div>
                    <div class="math-block !m-0 !w-full md:!w-64 justify-center text-cyan-400">
                        a/b ± c/b = (a ± c) / b
                    </div>
                </div>

                <!-- Multiplikation -->
                <div class="p-5 border border-slate-100 rounded-2xl flex flex-col md:flex-row gap-6 items-center hover:shadow-md transition-shadow">
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-800 mb-2">Gange (Multiplikation)</h4>
                        <p class="text-sm text-slate-500">Nemt! Tæller ganges med tæller, og nævner ganges med nævner. Man behøver <em>ikke</em> fællesnævner.</p>
                    </div>
                    <div class="math-block !m-0 !w-full md:!w-64 justify-center text-cyan-400">
                        (a/b) * (c/d) = (a*c) / (b*d)
                    </div>
                </div>

                <!-- Division -->
                <div class="p-5 border border-slate-100 rounded-2xl flex flex-col md:flex-row gap-6 items-center hover:shadow-md transition-shadow">
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-800 mb-2">Division</h4>
                        <p class="text-sm text-slate-500">Man dividerer med en brøk ved at <strong>vende den om og gange</strong> i stedet.</p>
                    </div>
                    <div class="math-block !m-0 !w-full md:!w-64 justify-center text-cyan-400">
                        (a/b) / (c/d) = (a/b) * (d/c)
                    </div>
                </div>
            </div>
        </section>

        <!-- Sektion 4: Reduktion -->
        <section class="content-card border-t-4 border-t-purple-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center">
                    <i class="fas fa-compress-alt text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">4. Reduktion</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                At reducere betyder "at gøre mindre" eller at skrive noget mere simpelt. Formålet er at samle alle de elementer, der er af samme type (fx samle alle x'er, samle alle y'er, og samle alle rene tal).
            </p>

            <div class="rule-box !border-purple-500 !bg-purple-50/50">
                <h3 class="font-bold text-purple-900 mb-2">Huskeregler for parenteser:</h3>
                <ul class="list-disc list-inside space-y-2 text-slate-700 text-sm">
                    <li><strong>Plus-parentes:</strong> Kan bare fjernes uden videre. Fx: <code class="bg-white px-1 rounded">+ (2x + 3) = + 2x + 3</code></li>
                    <li><strong>Minus-parentes:</strong> Når den hæves, skifter <em>alle</em> fortegn inde i parentesen. Fx: <code class="bg-white px-1 rounded">- (2x - 3) = - 2x + 3</code></li>
                    <li><strong>Gange ind:</strong> Tallet foran ganges med <em>hvert</em> led indeni. Fx: <code class="bg-white px-1 rounded">2(x + 4) = 2x + 8</code></li>
                </ul>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-slate-800">Snyd lidt i Maple</h4>
                    <p class="text-sm text-slate-500">Brug <code>simplify</code> kommandoen til automatisk at reducere store udtryk.</p>
                </div>
                <button onclick="copyToClipboard('simplify(2*(x+3) - (x-1))')" class="btn-copy hover:bg-purple-600 hover:text-white bg-slate-100 text-slate-600 border border-slate-200">
                    <i class="far fa-copy mr-2"></i>Kopiér
                </button>
            </div>
        </section>

        <!-- Næste emne knap -->
        <div class="flex justify-end mb-12">
            <a href="#" class="px-8 py-4 bg-slate-900 text-white rounded-2xl font-bold hover:bg-indigo-600 transition-colors shadow-lg shadow-indigo-500/20 flex items-center gap-3">
                Gå til Næste Emne: Standardfunktioner
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    </main>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-3 rounded-xl shadow-2xl opacity-0 transition-all pointer-events-none z-[100] flex items-center space-x-3 border border-slate-700">
        <i class="fas fa-check text-emerald-400"></i>
        <span class="font-bold text-sm">Kopieret til Maple!</span>
    </div>

    <script>
        // Kopiér funktion til Maple
        function copyToClipboard(text) {
            const el = document.createElement('textarea');
            el.value = text;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);

            const toast = document.getElementById('toast');
            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -10px)';
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, 0)';
            }, 2500);
        }

        // --- Math Particle Animation (Samme som forsiden) ---
        const canvas = document.getElementById('particle-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        const mathSymbols = ['+', '-', '=', 'x', 'y', 'a', 'b', '½', '÷', '()'];

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        class MathParticle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.symbol = mathSymbols[Math.floor(Math.random() * mathSymbols.length)];
                this.fontSize = Math.random() * 15 + 10;
                this.speedX = (Math.random() - 0.5) * 0.3;
                this.speedY = (Math.random() - 0.5) * 0.3;
                const colors = ['rgba(79, 70, 229, 0.3)', 'rgba(59, 130, 246, 0.3)', 'rgba(14, 165, 233, 0.3)'];
                this.color = colors[Math.floor(Math.random() * colors.length)];
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x > canvas.width + 20) this.x = -20;
                if (this.x < -20) this.x = canvas.width + 20;
                if (this.y > canvas.height + 20) this.y = -20;
                if (this.y < -20) this.y = canvas.height + 20;
            }
            draw() {
                ctx.fillStyle = this.color;
                ctx.font = `${this.fontSize}px 'Fira Code', monospace`;
                ctx.fillText(this.symbol, this.x, this.y);
            }
        }

        function initParticles() {
            particles = [];
            const particleCount = Math.floor(window.innerWidth / 30); 
            for (let i = 0; i < Math.min(particleCount, 50); i++) {
                particles.push(new MathParticle());
            }
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }

        window.addEventListener('resize', () => {
            resize();
            initParticles();
        });
        
        window.onload = () => {
            resize();
            initParticles();
            animateParticles();
        };
    </script>
</body>
</html>
