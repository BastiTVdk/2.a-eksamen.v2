<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Funktioner & Regression | Sankt Annæ 2.a</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-glow: rgba(79, 70, 229, 0.15);
            --slate-bg: #f8fafc;
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--slate-bg);
            color: #0f172a;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Math Particle Canvas */
        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            pointer-events: none;
            opacity: 0.5;
        }

        /* Dynamiske Baggrunds-blobs */
        .bg-blob {
            position: fixed;
            z-index: -1;
            filter: blur(120px);
            opacity: 0.15;
            pointer-events: none;
            border-radius: 50%;
            animation: drift 25s infinite alternate ease-in-out;
        }

        @keyframes drift {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(60px, -60px) scale(1.1); }
        }

        .content-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid #e2e8f0;
            border-radius: 2rem;
            padding: 2.5rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        }

        .math-block {
            font-family: 'Fira Code', monospace;
            background: #0f172a;
            color: #818cf8;
            padding: 1rem 1.5rem;
            border-radius: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 1rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .rule-box {
            background: rgba(79, 70, 229, 0.05);
            border-left: 4px solid var(--primary);
            padding: 1.5rem;
            border-radius: 0 1rem 1rem 0;
            margin: 1.5rem 0;
        }

        .btn-copy {
            background: rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-size: 0.8rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all 0.2s;
        }

        .btn-copy:hover {
            background: var(--primary);
            color: white;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--slate-bg); }
        ::-webkit-scrollbar-thumb { background: rgba(79, 70, 229, 0.3); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(79, 70, 229, 0.6); }
    </style>
</head>
<body class="min-h-screen pb-20">

    <!-- Animeret Partikel System -->
    <canvas id="particle-canvas"></canvas>

    <!-- Background Blobs -->
    <div class="bg-blob w-[600px] h-[600px] bg-cyan-300 top-[-10%] left-[-10%]"></div>
    <div class="bg-blob w-[500px] h-[500px] bg-blue-200 bottom-[10%] right-[-10%]"></div>

    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-indigo-100 shadow-sm">
        <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="matematik-skriftlig.html" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 rounded-full flex items-center justify-center transition-colors text-slate-600">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <span class="text-xl font-black tracking-tight block leading-none text-slate-900 uppercase">Funktioner & <span class="text-indigo-500">Regression</span></span>
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-1">Sankt Annæ Gymnasium 2.a</span>
                </div>
            </div>
            <div class="flex items-center gap-4 hidden sm:flex">
                <a href="opgavebank.html" class="text-xs font-black text-slate-500 hover:text-indigo-600 transition uppercase tracking-widest flex items-center gap-2">
                    <i class="fas fa-dumbbell"></i> Træn Emnet
                </a>
                <a href="maple.html" class="px-5 py-2 bg-indigo-50 text-indigo-600 rounded-full text-xs font-bold hover:bg-indigo-600 hover:text-white transition-all active:scale-95 uppercase tracking-wider border border-indigo-200">
                    Maple Guide
                </a>
            </div>
        </div>
    </nav>

    <!-- Header Section -->
    <header class="max-w-4xl mx-auto px-6 pt-16 pb-12 text-center relative">
        <div class="inline-block mb-4 px-4 py-1.5 rounded-full bg-cyan-50 border border-cyan-100 text-cyan-600 font-bold text-xs tracking-widest uppercase shadow-sm">
            Emne 02
        </div>
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter text-slate-900 mb-6 uppercase">
            De klassiske <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-blue-500 italic">Modeller</span>
        </h1>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto font-medium">
            Verden ændrer sig – og matematikken beskriver hvordan. Her lærer du alt om lineære, eksponentielle og potens-funktioner, og hvordan du finder den bedste model ud fra et datasæt (regression).
        </p>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6">
        
        <!-- Sektion 1: Lineære Funktioner -->
        <section class="content-card border-t-4 border-t-blue-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
                    <i class="fas fa-chart-line text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">1. Lineære Funktioner</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Beskriver en udvikling, hvor der lægges det samme beløb til, hver gang x stiger med 1. Grafen er en ret linje.
            </p>

            <div class="math-block block space-y-1 !bg-blue-900/10 !border-blue-500/30">
                <div class="text-center text-2xl font-bold text-blue-600">f(x) = a · x + b</div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-blue-600 mb-2">Hældningen (a)</h4>
                    <p class="text-sm text-slate-600">Hældningskoefficienten. Fortæller hvor meget grafen går op (eller ned), når du går 1 skridt til højre på x-aksen.</p>
                    <code class="block mt-2 text-xs bg-white p-2 rounded border text-slate-500">Formel: a = (y2 - y1) / (x2 - x1)</code>
                </div>
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-blue-600 mb-2">Skæringen (b)</h4>
                    <p class="text-sm text-slate-600">Begyndelsesværdien. Fortæller præcis hvor linjen skærer y-aksen (der hvor x = 0).</p>
                    <code class="block mt-2 text-xs bg-white p-2 rounded border text-slate-500">Formel: b = y1 - a · x1</code>
                </div>
            </div>
        </section>

        <!-- Sektion 2: Eksponentielle Funktioner -->
        <section class="content-card border-t-4 border-t-indigo-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center">
                    <i class="fas fa-rocket text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">2. Eksponentielle Funktioner</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Beskriver en procentvis udvikling. Hver gang x stiger med 1, <em>ganges</em> y med den samme faktor. Typisk brugt til at beskrive befolkningstal, bakterievækst og renter i banken.
            </p>

            <div class="math-block block space-y-1 !bg-indigo-900/10 !border-indigo-500/30">
                <div class="text-center text-2xl font-bold text-indigo-600">f(x) = b · a<sup>x</sup></div>
            </div>

            <div class="rule-box !border-indigo-500">
                <h3 class="font-bold text-indigo-900 mb-2">Fremskrivningsfaktoren (a)</h3>
                <p class="text-sm text-slate-700 mb-2">
                    Tallet <code class="bg-white px-1 rounded">a</code> fortæller hvor mange procent, vi vokser med. Sammenhængen mellem vækstraten (r) og a er: <strong>a = 1 + r</strong>.
                </p>
                <ul class="list-disc list-inside space-y-1 text-slate-600 text-sm">
                    <li>Vokser med 5%: <code class="bg-white px-1 rounded">a = 1.05</code></li>
                    <li>Vokser med 20%: <code class="bg-white px-1 rounded">a = 1.20</code></li>
                    <li>Aftager med 15%: <code class="bg-white px-1 rounded">a = 0.85</code></li>
                </ul>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-slate-800 mb-2">Fordoblingskonstant (T₂)</h4>
                    <p class="text-sm text-slate-600 mb-3">Hvor meget x skal vokse, før y bliver dobbelt så stor. Gælder når a > 1.</p>
                    <div class="math-block !m-0 !p-3">
                        <span class="text-sm">T₂ = ln(2) / ln(a)</span>
                        <button onclick="copyToClipboard('evalf(ln(2)/ln(a))')" class="btn-copy">Kopiér</button>
                    </div>
                </div>
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-slate-800 mb-2">Halveringskonstant (T½)</h4>
                    <p class="text-sm text-slate-600 mb-3">Hvor meget x skal vokse, før y bliver halvt så stor. Gælder når 0 < a < 1.</p>
                    <div class="math-block !m-0 !p-3">
                        <span class="text-sm">T½ = ln(0.5) / ln(a)</span>
                        <button onclick="copyToClipboard('evalf(ln(0.5)/ln(a))')" class="btn-copy">Kopiér</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sektion 3: Potensfunktioner -->
        <section class="content-card border-t-4 border-t-cyan-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-cyan-100 text-cyan-600 flex items-center justify-center">
                    <span class="font-serif italic font-bold text-xl">x²</span>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">3. Potensfunktioner</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Beskriver en sammenhæng, hvor både x og y ændrer sig med procenter. Når x stiger med en bestemt procent, stiger y også med en bestemt procent. (Bliver tit brugt i fysik og biologi, fx sammenhæng mellem dyrs vægt og overfladeareal).
            </p>

            <div class="math-block block space-y-1 !bg-cyan-900/10 !border-cyan-500/30">
                <div class="text-center text-2xl font-bold text-cyan-600">f(x) = b · x<sup>a</sup></div>
            </div>

            <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100 mt-6">
                <h4 class="font-bold text-cyan-600 mb-2">Procent-procent vækst</h4>
                <p class="text-sm text-slate-600 mb-4">
                    Hvis du kender fremskrivningsfaktoren for x (hvad x ganges med), kan du finde ud af hvad y ganges med, ved at opløfte x's fremskrivningsfaktor i <code class="bg-white border rounded px-1">a</code>.
                </p>
                <div class="math-block !m-0 text-cyan-400">
                    F(y) = F(x)ᵃ
                </div>
                <p class="text-xs text-slate-500 mt-3 italic">
                    Eksempel: For f(x) = 2 · x³. Hvis x ganges med 2 (vokser med 100%), så ganges y med 2³ = 8 (vokser med 700%).
                </p>
            </div>
        </section>

        <!-- Sektion 4: Regression -->
        <section class="content-card border-t-4 border-t-teal-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-teal-100 text-teal-600 flex items-center justify-center">
                    <i class="fas fa-table text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">4. Regression (Med datasæt)</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                I eksamensopgaver får du ofte en tabel med data (fx årstal og antal solgte biler). Du skal lave "regression" for at finde den funktion, der passer bedst til tallene.
            </p>

            <div class="rule-box !border-teal-500 !bg-teal-50/50 mb-6">
                <h3 class="font-bold text-teal-900 mb-2">Fremgangsmåde i Maple (Gym-pakken):</h3>
                <ol class="list-decimal list-inside space-y-2 text-slate-700 text-sm font-medium">
                    <li>Husk at indlæse <code>with(Gym):</code> i starten!</li>
                    <li>Definér dine data som lister: <code class="bg-white px-1 border rounded text-teal-600">X := [1, 2, 3, 4]</code> og <code class="bg-white px-1 border rounded text-teal-600">Y := [10, 20, 30, 40]</code>.</li>
                    <li>Vælg den rigtige regressionskommando.</li>
                </ol>
            </div>

            <div class="space-y-4">
                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-xl hover:bg-slate-50">
                    <span class="font-bold text-slate-700">Lineær Regression</span>
                    <button onclick="copyToClipboard('LinReg(X, Y)')" class="btn-copy !bg-slate-200 !text-slate-700 hover:!bg-teal-500 hover:!text-white">LinReg(X, Y)</button>
                </div>
                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-xl hover:bg-slate-50">
                    <span class="font-bold text-slate-700">Eksponentiel Regression</span>
                    <button onclick="copyToClipboard('ExpReg(X, Y)')" class="btn-copy !bg-slate-200 !text-slate-700 hover:!bg-teal-500 hover:!text-white">ExpReg(X, Y)</button>
                </div>
                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-xl hover:bg-slate-50">
                    <span class="font-bold text-slate-700">Potens Regression</span>
                    <button onclick="copyToClipboard('PowReg(X, Y)')" class="btn-copy !bg-slate-200 !text-slate-700 hover:!bg-teal-500 hover:!text-white">PowReg(X, Y)</button>
                </div>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-100">
                <h4 class="font-bold text-slate-800 mb-2">Hvad er et Residual?</h4>
                <p class="text-sm text-slate-600">
                    Når modellen er lavet, rammer den sjældent dataene 100% perfekt. Et <strong>residual</strong> er forskellen mellem den virkelige måling (fra tabellen) og den værdi modellen forudsiger.
                    <br><br>
                    <code class="bg-slate-100 p-2 rounded text-slate-700 block text-center">Residual = Målt y-værdi  −  Model y-værdi</code>
                </p>
            </div>
        </section>

        <!-- Navigation (Forrige / Næste) -->
        <div class="flex flex-col sm:flex-row justify-between gap-4 mb-12">
            <a href="mat-basis.html" class="px-6 py-4 bg-white border border-slate-200 text-slate-600 rounded-2xl font-bold hover:bg-slate-50 transition-colors flex items-center justify-center gap-3">
                <i class="fas fa-arrow-left"></i>
                Forrige: Basis & Ligninger
            </a>
            <a href="#" class="px-6 py-4 bg-slate-900 text-white rounded-2xl font-bold hover:bg-indigo-600 transition-colors shadow-lg shadow-indigo-500/20 flex items-center justify-center gap-3">
                Næste: Andengradspolynomier
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    </main>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-3 rounded-xl shadow-2xl opacity-0 transition-all pointer-events-none z-[100] flex items-center space-x-3 border border-slate-700">
        <i class="fas fa-check text-emerald-400"></i>
        <span class="font-bold text-sm">Kopieret til udklipsholder!</span>
    </div>

    <script>
        // Kopiér funktion
        function copyToClipboard(text) {
            const el = document.createElement('textarea');
            el.value = text;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);

            const toast = document.getElementById('toast');
            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -10px)';
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, 0)';
            }, 2500);
        }

        // --- Math Particle Animation ---
        const canvas = document.getElementById('particle-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        const mathSymbols = ['f(x)', 'ax+b', 'a^x', 'x^a', 'ln', 'R²', 'y', 'X', 'Y', '≈'];

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        class MathParticle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.symbol = mathSymbols[Math.floor(Math.random() * mathSymbols.length)];
                this.fontSize = Math.random() * 15 + 10;
                this.speedX = (Math.random() - 0.5) * 0.3;
                this.speedY = (Math.random() - 0.5) * 0.3;
                const colors = ['rgba(79, 70, 229, 0.3)', 'rgba(6, 182, 212, 0.3)', 'rgba(59, 130, 246, 0.3)'];
                this.color = colors[Math.floor(Math.random() * colors.length)];
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x > canvas.width + 20) this.x = -20;
                if (this.x < -20) this.x = canvas.width + 20;
                if (this.y > canvas.height + 20) this.y = -20;
                if (this.y < -20) this.y = canvas.height + 20;
            }
            draw() {
                ctx.fillStyle = this.color;
                ctx.font = `${this.fontSize}px 'Fira Code', monospace`;
                ctx.fillText(this.symbol, this.x, this.y);
            }
        }

        function initParticles() {
            particles = [];
            const particleCount = Math.floor(window.innerWidth / 30); 
            for (let i = 0; i < Math.min(particleCount, 50); i++) {
                particles.push(new MathParticle());
            }
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }

        window.addEventListener('resize', () => {
            resize();
            initParticles();
        });
        
        window.onload = () => {
            resize();
            initParticles();
            animateParticles();
        };
    </script>
</body>
</html>
