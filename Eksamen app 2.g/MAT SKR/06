<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trigonometri | Sankt Annæ 2.a</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-glow: rgba(79, 70, 229, 0.15);
            --slate-bg: #f8fafc;
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--slate-bg);
            color: #0f172a;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Math Particle Canvas */
        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            pointer-events: none;
            opacity: 0.5;
        }

        /* Dynamiske Baggrunds-blobs */
        .bg-blob {
            position: fixed;
            z-index: -1;
            filter: blur(120px);
            opacity: 0.15;
            pointer-events: none;
            border-radius: 50%;
            animation: drift 25s infinite alternate ease-in-out;
        }

        @keyframes drift {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(60px, -60px) scale(1.1); }
        }

        .content-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid #e2e8f0;
            border-radius: 2rem;
            padding: 2.5rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        }

        .math-block {
            font-family: 'Fira Code', monospace;
            background: #0f172a;
            color: #818cf8;
            padding: 1rem 1.5rem;
            border-radius: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 1rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .rule-box {
            background: rgba(79, 70, 229, 0.05);
            border-left: 4px solid var(--primary);
            padding: 1.5rem;
            border-radius: 0 1rem 1rem 0;
            margin: 1.5rem 0;
        }

        .btn-copy {
            background: rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-size: 0.8rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all 0.2s;
        }

        .btn-copy:hover {
            background: var(--primary);
            color: white;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--slate-bg); }
        ::-webkit-scrollbar-thumb { background: rgba(79, 70, 229, 0.3); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(79, 70, 229, 0.6); }
    </style>
</head>
<body class="min-h-screen pb-20">

    <!-- Animeret Partikel System -->
    <canvas id="particle-canvas"></canvas>

    <!-- Background Blobs -->
    <div class="bg-blob w-[600px] h-[600px] bg-indigo-400 top-[-10%] left-[10%]"></div>
    <div class="bg-blob w-[500px] h-[500px] bg-violet-300 bottom-[10%] right-[-10%]"></div>

    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-indigo-100 shadow-sm">
        <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="matematik-skriftlig.html" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 rounded-full flex items-center justify-center transition-colors text-slate-600">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <span class="text-xl font-black tracking-tight block leading-none text-slate-900 uppercase">Trigono<span class="text-indigo-500">metri</span></span>
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-1">Sankt Annæ Gymnasium 2.a</span>
                </div>
            </div>
            <div class="flex items-center gap-4 hidden sm:flex">
                <a href="opgavebank.html" class="text-xs font-black text-slate-500 hover:text-indigo-600 transition uppercase tracking-widest flex items-center gap-2">
                    <i class="fas fa-dumbbell"></i> Træn Emnet
                </a>
                <a href="maple.html" class="px-5 py-2 bg-indigo-50 text-indigo-600 rounded-full text-xs font-bold hover:bg-indigo-600 hover:text-white transition-all active:scale-95 uppercase tracking-wider border border-indigo-200">
                    Maple Guide
                </a>
            </div>
        </div>
    </nav>

    <!-- Header Section -->
    <header class="max-w-4xl mx-auto px-6 pt-16 pb-12 text-center relative">
        <div class="inline-block mb-4 px-4 py-1.5 rounded-full bg-violet-50 border border-violet-100 text-violet-600 font-bold text-xs tracking-widest uppercase shadow-sm">
            Emne 06
        </div>
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter text-slate-900 mb-6 uppercase">
            Trekanter & <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-500 to-indigo-500 italic">Vinkler</span>
        </h1>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto font-medium">
            Velkommen til trigonometrien. Her får du styr på de retvinklede trekanter (SOH-CAH-TOA), samt de generelle cosinus- og sinusrelationer, når trekanterne bliver skæve.
        </p>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6">
        
        <!-- Maple Tip / VIGTIGT -->
        <div class="bg-rose-50 border-l-4 border-rose-500 p-6 rounded-r-2xl mb-8 shadow-sm">
            <div class="flex items-center gap-3 mb-2">
                <i class="fas fa-exclamation-triangle text-rose-500 text-xl"></i>
                <h3 class="font-bold text-rose-900 text-lg">VIGTIGT: Grader vs. Radianer i Maple</h3>
            </div>
            <p class="text-slate-700 text-sm">
                Da Maple som standard regner i radianer, skal du sikre dig, at programmet forstår grader:
                <br><br>
                <strong>1. Gym-pakken:</strong> Hvis du har indlæst <code>with(Gym)</code>, kan du skrive <code>Sin(v)</code> og <code>Cos(v)</code> (med stort forbogstav) – så regner de automatisk i grader.
                <br>
                <strong>2. Den indbyggede:</strong> Brug <code>sind()</code>, <code>cosd()</code> og <code>tand()</code>.
                <br>
                <strong>3. Gradtegnet:</strong> Brug <code>sin(30&deg;)</code> og husk at indsætte gradtegnet (°) fra paletten.
                <br><br>
                Skriver du bare <code>sin(30)</code> uden "d", stort bogstav eller gradtegn, regner Maple i radianer!
            </p>
        </div>

        <!-- Sektion 1: Den Retvinklede Trekant -->
        <section class="content-card border-t-4 border-t-blue-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
                    <i class="fas fa-ruler-triangle text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">1. Retvinklede Trekanter</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                I en retvinklet trekant (hvor én vinkel er præcis 90°) gælder Pythagoras, men også de tre basale trigonometriske funktioner.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
                <!-- Sinus -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-center">
                    <h4 class="font-bold text-blue-600 mb-2">Sinus (sin)</h4>
                    <p class="text-xs text-slate-500 mb-2">Modstående katete divideret med hypotenusen.</p>
                    <div class="math-block !m-0 !p-2 justify-center text-sm font-bold">
                        sin(v) = mod / hyp
                    </div>
                </div>
                <!-- Cosinus -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-center">
                    <h4 class="font-bold text-blue-600 mb-2">Cosinus (cos)</h4>
                    <p class="text-xs text-slate-500 mb-2">Hosliggende katete divideret med hypotenusen.</p>
                    <div class="math-block !m-0 !p-2 justify-center text-sm font-bold">
                        cos(v) = hos / hyp
                    </div>
                </div>
                <!-- Tangens -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-center">
                    <h4 class="font-bold text-blue-600 mb-2">Tangens (tan)</h4>
                    <p class="text-xs text-slate-500 mb-2">Modstående katete divideret med den hosliggende.</p>
                    <div class="math-block !m-0 !p-2 justify-center text-sm font-bold">
                        tan(v) = mod / hos
                    </div>
                </div>
            </div>
        </section>

        <!-- Sektion 2: Cosinusrelationerne -->
        <section class="content-card border-t-4 border-t-violet-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-violet-100 text-violet-600 flex items-center justify-center">
                    <i class="fas fa-compress-arrows-alt text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">2. Cosinusrelationerne</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Cosinusrelationerne virker på <strong>alle</strong> trekanter, uanset om de er retvinklede eller ej. Det er en slags udvidet Pythagoras.
            </p>

            <div class="rule-box !border-violet-500 !bg-violet-50/50 mb-6">
                <h3 class="font-bold text-violet-900 mb-2">Hvornår bruges de?</h3>
                <ul class="list-disc list-inside space-y-1 text-slate-700 text-sm font-medium">
                    <li>Når du kender alle 3 sider og skal finde en vinkel.</li>
                    <li>Når du kender 2 sider og vinklen <em>imellem</em> dem, og skal finde den sidste side.</li>
                </ul>
            </div>

            <div class="math-block block space-y-1 !bg-violet-900/10 !border-violet-500/30">
                <div class="text-center text-xl font-bold text-violet-600">c² = a² + b² - 2·a·b · cos(C)</div>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-100 flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-slate-800">Cosinusrelation i Maple</h4>
                    <p class="text-sm text-slate-500">Sæt dine tal ind og brug solve (Husk cosd eller Cos!).</p>
                </div>
                <button onclick="copyToClipboard('solve(c^2 = a^2 + b^2 - 2*a*b*cosd(C), c)')" class="btn-copy !bg-slate-100 !text-slate-600 hover:!bg-violet-600 hover:!text-white border border-slate-200">
                    <i class="far fa-copy mr-2"></i>Kopiér
                </button>
            </div>
        </section>

        <!-- Sektion 3: Sinusrelationerne -->
        <section class="content-card border-t-4 border-t-cyan-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-cyan-100 text-cyan-600 flex items-center justify-center">
                    <i class="fas fa-expand-arrows-alt text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">3. Sinusrelationerne</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Sinusrelationerne beskriver forholdet mellem en vinkel og den side, der ligger over for den. De er super nemme at bruge, når du har "par" af sider og modstående vinkler.
            </p>

            <div class="math-block block space-y-1 !bg-cyan-900/10 !border-cyan-500/30">
                <div class="text-center text-xl font-bold text-cyan-600">a / sin(A) = b / sin(B) = c / sin(C)</div>
            </div>

            <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl mt-6">
                <h4 class="font-bold text-amber-900 mb-1"><i class="fas fa-exclamation-circle mr-2"></i>Pas på Sinus-fælden!</h4>
                <p class="text-sm text-slate-700">
                    Når du bruger sinusrelationen til at finde en vinkel, kan der ofte være to løsninger (f.eks. en spids og en stump vinkel, der har samme sinusværdi). Kig altid på opgavens tegning for at vurdere, om vinklen er stump (>90°) eller spids (<90°). Brug evt. <code>intervalsolve</code> i Maple.
                </p>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-100 flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-slate-800">Sinusrelation i Maple</h4>
                    <p class="text-sm text-slate-500">Vælg to af brøkerne og isolér.</p>
                </div>
                <button onclick="copyToClipboard('solve(a / sind(A) = b / sind(B), A)')" class="btn-copy !bg-slate-100 !text-slate-600 hover:!bg-cyan-600 hover:!text-white border border-slate-200">
                    <i class="far fa-copy mr-2"></i>Kopiér
                </button>
            </div>
        </section>

        <!-- Sektion 4: Arealet af en trekant -->
        <section class="content-card border-t-4 border-t-emerald-500">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
                    <i class="fas fa-chart-area text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">4. Areal af en Trekant</h2>
            </div>
            
            <p class="text-slate-600 leading-relaxed mb-4">
                Alle kender T = ½ · h · g. Men i trigonometrien kender vi oftest ikke højden. I stedet bruger vi appelsinformlen (også kendt som den trigonometriske arealformel).
            </p>

            <div class="math-block block space-y-1 !bg-emerald-900/10 !border-emerald-500/30">
                <div class="text-center text-xl font-bold text-emerald-600">T = ½ · a · b · sin(C)</div>
            </div>

            <p class="text-sm text-slate-600 mt-4">
                <strong>Huskeregel:</strong> For at finde arealet, skal du kende to sider (f.eks. a og b) og den vinkel, der ligger <em>imellem</em> dem (vinkel C).
            </p>
        </section>

        <!-- Navigation (Forrige / Næste) -->
        <div class="flex flex-col sm:flex-row justify-between gap-4 mb-12">
            <a href="mat-geometri.html" class="px-6 py-4 bg-white border border-slate-200 text-slate-600 rounded-2xl font-bold hover:bg-slate-50 transition-colors flex items-center justify-center gap-3">
                <i class="fas fa-arrow-left"></i>
                Forrige: Analytisk Geometri
            </a>
            <a href="#" class="px-6 py-4 bg-slate-900 text-white rounded-2xl font-bold hover:bg-indigo-600 transition-colors shadow-lg shadow-indigo-500/20 flex items-center justify-center gap-3">
                Næste: Sandsynlighedsregning
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    </main>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-3 rounded-xl shadow-2xl opacity-0 transition-all pointer-events-none z-[100] flex items-center space-x-3 border border-slate-700">
        <i class="fas fa-check text-emerald-400"></i>
        <span class="font-bold text-sm">Kopieret til udklipsholder!</span>
    </div>

    <script>
        // Kopiér funktion
        function copyToClipboard(text) {
            const el = document.createElement('textarea');
            el.value = text;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);

            const toast = document.getElementById('toast');
            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -10px)';
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, 0)';
            }, 2500);
        }

        // --- Math Particle Animation ---
        const canvas = document.getElementById('particle-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        const mathSymbols = ['sin(v)', 'cos(v)', 'tan(v)', 'a²+b²=c²', 'θ', '△', 'sind()', 'cosd()', 'A', 'B', 'C'];

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        class MathParticle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.symbol = mathSymbols[Math.floor(Math.random() * mathSymbols.length)];
                this.fontSize = Math.random() * 15 + 10;
                this.speedX = (Math.random() - 0.5) * 0.3;
                this.speedY = (Math.random() - 0.5) * 0.3;
                const colors = ['rgba(79, 70, 229, 0.3)', 'rgba(139, 92, 246, 0.3)', 'rgba(14, 165, 233, 0.3)'];
                this.color = colors[Math.floor(Math.random() * colors.length)];
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x > canvas.width + 20) this.x = -20;
                if (this.x < -20) this.x = canvas.width + 20;
                if (this.y > canvas.height + 20) this.y = -20;
                if (this.y < -20) this.y = canvas.height + 20;
            }
            draw() {
                ctx.fillStyle = this.color;
                ctx.font = `${this.fontSize}px 'Fira Code', monospace`;
                ctx.fillText(this.symbol, this.x, this.y);
            }
        }

        function initParticles() {
            particles = [];
            const particleCount = Math.floor(window.innerWidth / 30); 
            for (let i = 0; i < Math.min(particleCount, 40); i++) {
                particles.push(new MathParticle());
            }
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }

        window.addEventListener('resize', () => {
            resize();
            initParticles();
        });
        
        window.onload = () => {
            resize();
            initParticles();
            animateParticles();
        };
    </script>
</body>
</html>
